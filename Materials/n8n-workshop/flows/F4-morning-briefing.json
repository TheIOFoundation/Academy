{
  "name": "WS F4 Morning briefing",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "86dd3d18-50cc-4bc6-8790-c7307cae7aa3",
      "name": "Every Morning",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        96
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f4-chat",
              "name": "chatId",
              "value": "PUT-YOUR-CHAT-ID-HERE",
              "type": "string"
            },
            {
              "id": "f4-city",
              "name": "city",
              "value": "Jakarta",
              "type": "string"
            },
            {
              "id": "f4-lat",
              "name": "latitude",
              "value": -6.2,
              "type": "number"
            },
            {
              "id": "f4-lon",
              "name": "longitude",
              "value": 106.8,
              "type": "number"
            },
            {
              "id": "f4-nasa",
              "name": "nasaKey",
              "value": "DEMO_KEY",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5d149034-a4a4-482e-876b-82c9ed97f604",
      "name": "My Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        224,
        96
      ]
    },
    {
      "parameters": {
        "url": "=https://api.open-meteo.com/v1/forecast?latitude={{ $json.latitude }}&longitude={{ $json.longitude }}&current=temperature_2m&daily=temperature_2m_max,precipitation_probability_max&timezone=auto&forecast_days=1",
        "options": {}
      },
      "id": "56a420c5-eea8-47b0-8bbb-022e81fe63ad",
      "name": "Get Weather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://api.nasa.gov/planetary/apod?api_key={{ $json.nasaKey }}",
        "options": {}
      },
      "id": "30d5b099-c061-4b0d-88e7-0c0bd9a05781",
      "name": "Get NASA Picture of the Day",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        448,
        192
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "01be3f2e-d2a1-4268-a976-3bf2e6081c44",
      "name": "Combine Both",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        672,
        96
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f4-caption",
              "name": "caption",
              "value": "=Good morning from {{ $(\"My Settings\").item.json.city }}. Now {{ $json.current.temperature_2m }}°C, high {{ $json.daily.temperature_2m_max[0] }}°C, rain chance {{ $json.daily.precipitation_probability_max[0] }}%. NASA says: {{ $json.title }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "5faeddbb-895c-4fe9-b141-ca90caa15162",
      "name": "Write the Briefing",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        896,
        96
      ]
    },
    {
      "parameters": {
        "operation": "sendPhoto",
        "chatId": "={{ $(\"My Settings\").item.json.chatId }}",
        "file": "={{ $json.url }}",
        "additionalFields": {
          "caption": "={{ $json.caption }}"
        }
      },
      "id": "d4090a6b-1d61-4b43-846e-fa322a08a811",
      "name": "Send Briefing",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1120,
        96
      ]
    },
    {
      "parameters": {
        "content": "## F4 Morning briefing\nFill in \"My Settings\" (chat ID and city). To see it now instead of tomorrow: change the schedule to \"Minutes\", every 2 minutes, then Publish. Switch it off afterwards.\n\nNote: if NASA returns a video instead of a photo, Telegram will complain. Run again tomorrow or use the hdurl field.",
        "height": 632,
        "width": 1436,
        "color": 5
      },
      "id": "db077d6e-ed56-40d7-8914-1aca37f75e66",
      "name": "Notes F4",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -112,
        -224
      ]
    }
  ],
  "connections": {
    "Every Morning": {
      "main": [
        [
          {
            "node": "My Settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "My Settings": {
      "main": [
        [
          {
            "node": "Get Weather",
            "type": "main",
            "index": 0
          },
          {
            "node": "Get NASA Picture of the Day",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Weather": {
      "main": [
        [
          {
            "node": "Combine Both",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get NASA Picture of the Day": {
      "main": [
        [
          {
            "node": "Combine Both",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Combine Both": {
      "main": [
        [
          {
            "node": "Write the Briefing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write the Briefing": {
      "main": [
        [
          {
            "node": "Send Briefing",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}